{
  "manifest_version": 3,
  "name": "Battlestation · Vidéo",
  "version": "0.3.2",
  "description": "Miroir local de la vidéo YouTube vers le dock Battlestation.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "video.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "video-frame.html"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Battlestation · connecter la vidéo"
  }
}
