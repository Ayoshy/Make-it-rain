<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF owns DPI through its manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../assets/Fonts/art-deco.ttf" Link="Assets/Fonts/art-deco.ttf" />
    <ProjectReference Include="../Battlestation.Core/Battlestation.Core.csproj" />
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.25.260303002" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
